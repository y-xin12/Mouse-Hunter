class_name LevelDefinition
extends Resource
## Data definition of a puzzle level: board size, hidden mice and the
## piece set to arrange. Pure data -- no gameplay or scene dependencies.

@export var id: String = ""
@export var room: String = ""
@export var board_size: Vector2i = Vector2i(4, 6)
@export var mice: Array[Vector2i] = []
## Wall hints: flat list of adjacent cell pairs (a1, b1, a2, b2, ...). The
## edge shared by each pair is walled -- no single piece may cover both
## cells. Walls never occupy cells and never change the board area or the
## win condition; they only constrain placement, as a guideline for the
## player.
@export var walls: Array[Vector2i] = []
## Adaptive-difficulty wall variants in the same flat-pair format as
## `walls`: "easy" = the base walls plus extra hint walls, "hard" = a
## reduced subset. The base `walls` list itself is the "medium" variant.
## Generated by tests/variant_generator.py from each level's reference
## solution, so a variant can never invalidate the shipped solution.
## Which variant a level loads with is decided by GameManager from the
## player's skill tier and pinned in the save file.
@export var wall_variants: Dictionary = {}
## Kept untyped on purpose: elements are PieceDefinition resources and an
## untyped Array serializes plainly in .tres files.
@export var pieces: Array = []


static func get_level_category(level_number: int) -> String:
	## Internal challenge category for a numbered (1-based) level: levels
	## ending in 7 are "hard" milestones, levels ending in 2 beyond Level 2
	## are "super_hard" milestones, and everything else (including Level 2
	## itself) is "normal". The category describes the intended challenge
	## of the numbered level and is deliberately SEPARATE from the
	## easy/medium/hard wall variants a level may carry.
	if level_number > 2 and level_number % 10 == 2:
		return "super_hard"
	if level_number % 10 == 7:
		return "hard"
	return "normal"


func get_room_title() -> String:
	return room.capitalize()


func get_wall_variant(variant: String) -> Array[Vector2i]:
	## Wall set for a variant name; the base `walls` list is "medium".
	## Unknown or missing variants fall back to the base walls. A stored
	## empty array is legitimate (a "hard" variant may drop every hint).
	if variant == "medium" or not wall_variants.has(variant):
		return walls.duplicate()
	var stored: Variant = wall_variants[variant]
	if not stored is Array:
		return walls.duplicate()
	var result: Array[Vector2i] = []
	for cell in stored:
		if cell is Vector2i:
			result.append(cell)
	return result
